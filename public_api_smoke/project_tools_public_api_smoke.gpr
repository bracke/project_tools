with "../project_tools.gpr";

project Project_Tools_Public_API_Smoke is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("project_tools_public_api_smoke.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU");
   end Compiler;
end Project_Tools_Public_API_Smoke;
