with "../project_tools.gpr";
project Project_Tools_Check_All is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("check_all.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatW8", "-gnatwa");
   end Compiler;
end Project_Tools_Check_All;
